# Core infrastructure
DATABASE_URL=
# Server-owned organization for dedicated website records and scoped workers
WEBSITE_ORG_ID=
PORT=5000
NODE_ENV=production

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=

# Maps
GOOGLE_MAPS_API_KEY=
# Client map key for direct browser maps access (if enabled)
VITE_GOOGLE_MAPS_API_KEY=

# Email (SendGrid)
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=
STAFF_NOTIFICATION_EMAIL=
# Comma-separated explicitly approved synthetic recipients outside production
PEGASUS_NOTIFICATION_ALLOWED_RECIPIENTS=

# Versioned website HQ bridge (server-only; separate from legacy intake)
PEGASUS_HQ_WEBSITE_INQUIRY_URL=
PEGASUS_WEBSITE_INQUIRY_TOKEN=
# Legacy endpoint is not used by the website delivery worker
PEGASUS_HQ_PUBLIC_INTAKE_URL=

# Auth/session (required when Replit Auth is enabled)
ISSUER_URL=
REPL_ID=
SESSION_SECRET=

# Optional environment toggles
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
VITE_APP_ENV=production

# Optional AI integrations
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional object storage overrides
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# Every background task is off unless its global flag is exactly "true".
# Keep legacy seeding/reports off for the dedicated website schema.
PEGASUS_ENABLE_SEEDING=false
PEGASUS_ENABLE_HQ_DELIVERY_WORKER=false
PEGASUS_ENABLE_NOTIFICATION_WORKER=false
PEGASUS_ENABLE_PEGGY_REPORTS=false

# Preview additionally requires its corresponding flag to be exactly "true".
# APP_ENV or VERCEL_ENV=preview enables the extra gate; serverless never starts tasks.
PEGASUS_PREVIEW_ENABLE_SEEDING=false
PEGASUS_PREVIEW_ENABLE_HQ_RECOVERY=false
PEGASUS_PREVIEW_ENABLE_NOTIFICATIONS=false
PEGASUS_PREVIEW_ENABLE_PEGGY_REPORTS=false
