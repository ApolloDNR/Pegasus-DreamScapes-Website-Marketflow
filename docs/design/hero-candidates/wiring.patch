 @keyframes hv-rise-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
 @keyframes hv-rule-in { from { opacity: 0; transform: scaleX(0); } to { opacity: 1; transform: scaleX(1); } }
 @keyframes hv-fade-in { from { opacity: 0; } to { opacity: 1; } }
-@keyframes hv-bloom-in { from { opacity: 0; transform: scale(1.012); } to { opacity: .96; transform: none; } }
+@keyframes hv-bloom-in { from { opacity: 0; transform: scale(1.012); } to { opacity: 1; transform: none; } }
+
+/* The masterpiece hero art (painted nocturne, graded to brand navy).
+   The wash seats the painting into the field so the headline sits on
+   near-black; on phones the art fills the frame behind a heavier wash. */
+.hv-hero-art-wrap { position:absolute; inset:0; z-index:1; overflow:hidden; }
+.hv-hero-art { position:absolute; right:0; top:0; height:100%; width:72%;
+  object-fit:cover; object-position:center right; }
+.hv-hero-art-wash { position:absolute; inset:0;
+  background: linear-gradient(90deg, var(--hv-navy2) 0%, rgba(9,20,33,.86) 26%,
+    rgba(9,20,33,.4) 46%, rgba(9,20,33,0) 64%),
+    linear-gradient(0deg, rgba(9,20,33,.55) 0%, rgba(9,20,33,0) 22%); }
+@media (max-width: 900px) {
+  .hv-hero-art { width:100%; object-position: 62% center; }
+  .hv-hero-art-wash { background:
+    linear-gradient(90deg, rgba(9,20,33,.92) 0%, rgba(9,20,33,.55) 40%, rgba(9,20,33,.28) 100%),
+    linear-gradient(0deg, rgba(9,20,33,.6) 0%, rgba(9,20,33,0) 26%); }
+}
 .hv-cta-row { display:flex; align-items:center; flex-wrap:wrap; gap: 1.1rem 1.4rem; margin-top: 2.6rem; }
 .hv-hero-link { font-size:.82rem; letter-spacing:.05em; color: rgba(245,230,211,.74);
   border-bottom: 1px solid rgba(200,122,58,.55); padding-bottom: 3px; transition: color .3s var(--ease-smooth, cubic-bezier(.16,1,.3,1)); }
